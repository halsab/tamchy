{
  "name": "tamchy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.20.0",
    "npm": "11.19.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "npm run assets:prepare && vite --host 127.0.0.1",
    "assets:prepare": "node scripts/prepare-assets.ts",
    "validate:catalog": "npm run assets:prepare && node scripts/validate-content.ts catalog",
    "validate:content": "npm run assets:prepare && node scripts/validate-content.ts content",
    "build": "npm run typecheck && npm run validate:content && vite build",
    "build:check": "npm run typecheck && npm run validate:catalog && vite build --mode check",
    "preview": "vite preview --host 127.0.0.1",
    "preview:check": "vite preview --mode check --host 127.0.0.1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.game.json && tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "test:unit": "vitest run --exclude 'tests/integration/**'",
    "test:integration": "vitest run tests/integration"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "sharp": "0.35.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "zod": "4.5.4"
  }
}
